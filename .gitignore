# os
.DS_Store
Thumbs.db

# validation outputs (regenerated by running validation)
# subdirectory outputs are ignored; .gitkeep files keep the dirs tracked
validation/lmm_validation/r_data/*
validation/lmm_validation/qc_plots/*
validation/port_validation/r_data/*
validation/port_validation/qc_plots/*
!validation/lmm_validation/r_data/.gitkeep
!validation/lmm_validation/qc_plots/.gitkeep
!validation/port_validation/r_data/.gitkeep
!validation/port_validation/qc_plots/.gitkeep

# data files (too large for git)
*.h5
*.h5ad
*.hdf5
*.rds
*.RData
*.bed.gz
*.bim
*.fam

# slurm
slurm-*.out
logs/
