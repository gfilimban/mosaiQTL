!validation/phase2/py_data/.gitkeep
!validation/phase2/plots/.gitkeep
!validation/phase3/r_data/.gitkeep
!validation/phase3/py_data/.gitkeep
!validation/phase3/plots/.gitkeep
validation/phase2/logs/*
validation/phase3/logs/*
!validation/phase2/logs/.gitkeep
!validation/phase3/logs/.gitkeep

# HPC-only SLURM scripts — generated on HPC, never committed
validation/run_validation_slurm.sh
validation/rerun_failed_chrs.sh
validation/run_gastroc_slurm.sh
