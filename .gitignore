# python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
*.so *.o

# environments
.venv/ venv/ *.conda/

# ide
.vscode/ .idea/ *.swp *.swo

# jupyter
.ipynb_checkpoints/

# os
**/.DS_Store
Thumbs.db

# local claude config — private, never committed
.claude/
.claudeignore

# validation outputs — regenerated at runtime; .gitkeep preserves dirs
validation/phase2/r_data/*
validation/phase2/py_data/*
validation/phase2/compare/*
validation/phase2/plots/*
validation/phase2/r_plots/*
validation/phase2/allele_dir/
validation/phase3/r_data/*
validation/phase3/py_data/*
validation/phase3/plots/*
!validation/phase2/r_data/.gitkeep
!validation/phase2/py_data/.gitkeep
!validation/phase2/plots/.gitkeep
!validation/phase3/r_data/.gitkeep
!validation/phase3/py_data/.gitkeep
!validation/phase3/plots/.gitkeep
validation/phase2/logs/*
validation/phase3/logs/*
!validation/phase2/logs/.gitkeep
!validation/phase3/logs/.gitkeep

# HPC-only SLURM scripts — generated on HPC, never committed
validation/run_validation_slurm.sh
validation/rerun_failed_chrs.sh
validation/run_gastroc_slurm.sh
validation/rerun_failed_chrs_gastroc.sh

# data files
*.h5
*.h5ad
*.hdf5
*.rds
*.RData
*.bed.gz
*.bim
*.fam

# validation phase1 — R probs CSVs (79 MB, regenerated by port_sim_validation.R)
validation/phase1/r_data/probs/

# slurm logs
slurm-*.out

# checkpoint files (safe-point markers)
validation/phase2/py_data/*.done
validation/phase3/py_data/*.done

# bundle (transferred separately, not committed)
mosaiqtl.bundle

# sparc validation data — large binary files, regenerated from R script
validation/sparcc_cache/
validation/sparcc_data/
tests/fixtures/data/

# gastroc benchmark — large data files and regenerated outputs
validation/gastroc_data/counts_lognorm.h5
validation/gastroc_data/gastroc_pheno.rds
validation/gastroc_data/metadata.csv
validation/gastroc_data/*.csv
validation/gastroc_data/plots/
validation/gastroc_data/r_data/
validation/gastroc_data/py_data/
validation/gastroc_data/compare/
validation/gastroc_data/chr*/
validation/gastroc_data/genomecache_collapsed/

# slide deck build artifacts
docs/slides/*.pptx

