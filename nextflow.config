/*
 * mosaiQTL — Nextflow configuration
 * All resource tiers defined here; profiles select execution backend.
 */

manifest {
    name        = 'mosaiQTL'
    description = 'Multiomics haplotype-based QTL mapping'
    version     = '0.6.4'
    nextflowVersion = '>=23.04'
}

params {
    // shared reference files
    genomecache     = null
    data_dir        = null
    // derived from data_dir when null (see block below)
    kinship_loco    = null
    metadata        = null
    sanger_alleles  = null
    covariates      = 'sex,dataset'

    // cell-type inputs
    celltypes_dir = null
    celltypes     = 'all'
    gene_info     = null
    phenotypes    = null   // single-CT mode
    celltype      = null   // single-CT mode

    // scan settings
    output_dir    = 'results'
    scan_type     = 'lmm'
    scan_window   = 'cis'
    chroms        = 'all'
    n_perms       = 1000
    window_mb     = 1.0
}

// Derive ref-file paths from data_dir when not set explicitly
if (params.data_dir) {
    if (!params.kinship_loco)   params.kinship_loco   = "${params.data_dir}/kinship_loco.h5"
    if (!params.metadata)       params.metadata       = "${params.data_dir}/igvf_sample_metadata.csv"
    if (!params.sanger_alleles) params.sanger_alleles = "${params.data_dir}/sanger_alleles.h5"
}

// ── process defaults ──────────────────────────────────────────────────────────

process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_single {
        cpus   = 1
        memory = '8 GB'
        time   = '2h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '32 GB'
        time   = '24h'
    }
    withLabel: process_high {
        cpus   = 16
        memory = '64 GB'
        time   = '12h'
    }
    withLabel: process_long {
        cpus   = 8
        memory = '32 GB'
        time   = '24h'
    }
}

// ── profiles ──────────────────────────────────────────────────────────────────

profiles {

    local {
        process.executor = 'local'
        // override memory limits for local dev/testing (no HPC scheduler)
        process {
            withLabel: process_single { memory = '4 GB'  }
            withLabel: process_medium { memory = '8 GB'; cpus = 2 }
            withLabel: process_high   { memory = '12 GB'; cpus = 4 }
            withLabel: process_long   { memory = '8 GB'  }
        }
    }

    slurm {
        process {
            executor  = 'slurm'
            scratch   = true
            clusterOptions = "--account=${System.getenv('SLURM_ACCOUNT') ?: 'default'}"
        }
        executor {
            queueSize       = 200
            submitRateLimit = '10/1min'
        }
    }

    test {
        process.executor = 'local'
        params {
            chroms  = '1'
            n_perms = 100
        }
    }

}
