/*
 * mosaiQTL — Nextflow configuration
 * All resource tiers defined here; profiles select execution backend.
 */

manifest {
    name        = 'mosaiQTL'
    description = 'Multiomics haplotype-based QTL mapping'
    version     = '0.2.0'
    nextflowVersion = '>=23.04'
}

params {
    genomecache   = null
    kinship_loco  = null
    phenotypes    = null
    metadata      = null
    output_dir    = 'results'
    scan_type     = 'lmm'
    chroms        = 'all'
    n_perms       = 1000
    scan_window   = 'cis'
    gene_info     = null
}

// ── process defaults ──────────────────────────────────────────────────────────

process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_single {
        cpus   = 1
        memory = '8 GB'
        time   = '2h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '32 GB'
        time   = '24h'
    }
    withLabel: process_high {
        cpus   = 16
        memory = '64 GB'
        time   = '12h'
    }
    withLabel: process_long {
        cpus   = 8
        memory = '32 GB'
        time   = '24h'
    }
}

// ── profiles ──────────────────────────────────────────────────────────────────

profiles {

    local {
        process.executor = 'local'
    }

    slurm {
        process {
            executor  = 'slurm'
            scratch   = true
            clusterOptions = "--account=${System.getenv('SLURM_ACCOUNT') ?: 'default'}"
        }
        executor {
            queueSize       = 200
            submitRateLimit = '10/1min'
        }
    }

    test {
        process.executor = 'local'
        params {
            chroms  = '1'
            n_perms = 100
        }
    }

}
