/*
 * mosaiQTL — Nextflow configuration
 * All resource tiers defined here; profiles select execution backend.
 */

manifest {
    name        = 'mosaiQTL'
    description = 'Multiomics haplotype-based QTL mapping'
    version     = '0.7.2'
    nextflowVersion = '>=23.04'
}

params {
    // shared reference files
    genomecache     = null
    data_dir        = null
    // derived from data_dir at workflow startup when not set explicitly
    kinship_loco    = null
    metadata        = null
    sanger_alleles  = null
    covariates      = 'sex,dataset'

    // cell-type inputs
    celltypes_dir = null
    celltypes     = 'all'
    gene_info     = null
    phenotypes    = null   // single-CT mode
    celltype      = null   // single-CT mode

    // scan settings
    output_dir    = 'results'
    model         = 'lmm'      // lmm | nb-glmm
    scan_type     = 'L'        // L (local ±window_mb) | C (chromosome-wide) | G (genome-wide)
    chroms        = 'all'
    n_perms       = 1000
    window_mb     = 1.0
    use_rint      = true       // rank-inverse normal transform before LMM scan
    gtf           = null
}

// ── process defaults ──────────────────────────────────────────────────────────

process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_single {
        cpus   = 1
        memory = '8 GB'
        time   = '2h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '32 GB'
        time   = '24h'
    }
    withLabel: process_high {
        cpus   = 16
        memory = '64 GB'
        time   = '12h'
    }
    withLabel: process_long {
        cpus   = 8
        memory = '32 GB'
        time   = '24h'
    }
    withLabel: process_ultra {
        cpus   = 16
        memory = '128 GB'
        time   = '12h'
    }
}

// ── trace: per-task time and memory, recorded by `make bench-trace` ─────────
trace {
    enabled   = true
    overwrite = true
    raw       = true
    file      = "${params.output_dir ?: launchDir}/logs/trace.txt"
    fields    = 'task_id,name,status,exit,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

// ── profiles ──────────────────────────────────────────────────────────────────

profiles {

    local {
        process.executor = 'local'
        // override memory limits for local dev/testing (no HPC scheduler)
        process {
            withLabel: process_single { memory = '4 GB'  }
            withLabel: process_medium { memory = '8 GB'; cpus = 2 }
            withLabel: process_high   { memory = '12 GB'; cpus = 4 }
            withLabel: process_long   { memory = '8 GB'  }
        }
    }

    slurm {
        process {
            executor       = 'slurm'
            scratch        = true
            queue          = 'standard'
            clusterOptions = '--account=seyedam_lab'
        }
        executor {
            queueSize       = 200
            submitRateLimit = '10/1min'
        }
    }

    test {
        process.executor = 'local'
        params {
            chroms  = '1'
            n_perms = 100
        }
    }

    // ── per-tissue work-dir profiles ─────────────────────────────────────────
    // combine with 'slurm' to route each tissue's work files to its own subdir
    // under work/ so runs never share hash space.
    // pair with NXF_CACHE_DIR=.nf_cache/{tissue}/{type} in the run command
    // so each tissue also gets its own session history and plain -resume works.
    ctxhipp_ct { workDir = "${launchDir}/work/ctxhipp/celltypes" }
    ctxhipp_st { workDir = "${launchDir}/work/ctxhipp/subtypes"  }
    gastroc_ct { workDir = "${launchDir}/work/gastroc/celltypes" }
    gastroc_st { workDir = "${launchDir}/work/gastroc/subtypes"  }

}
